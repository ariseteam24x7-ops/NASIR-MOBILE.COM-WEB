# ========================================================
# Nasir Mobile Dubai — Environment Variables Configuration
# ========================================================

# Host & Port
PORT=3000
APP_URL="https://nasirmobile.com"

# Authorized Store Owner Configuration
OWNER_EMAIL="shazzzbusiness@gmail.com"
OWNER_SETUP_KEY="YourSecureOwnerPasswordHere"

# Relational PostgreSQL Database Credentials (Provided automatically in Cloud SQL)
# NOTE: Object method variables are used by the runtime pg pool.
SQL_HOST="127.0.0.1"
SQL_DB_NAME="nasir_mobile_db"
SQL_USER="nasir_app_user"
SQL_PASSWORD="your_app_password"

# Schema Management & Migration Admin Credentials (Drizzle Kit)
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="your_admin_password"

# AI Studio runtime keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Cloud Backend Configuration
# Obtain from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-jwt-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-admin-key"
